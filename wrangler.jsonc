{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site",
  "main": "workers/site/src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "lyjw.me", "custom_domain": true },
    { "pattern": "preview.lyjw.dev", "custom_domain": true, "previews_enabled": true, "enabled": false }
  ],
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },
  "vars": {
    "SITE_ENV": "production",
    "PUBLIC_BACKEND_URL": "https://lyjw.me",
    "ALLOWED_ORIGINS": "https://lyjw131.com,https://lyjw.me,https://dev.lyjw.me"
  },
  "services": [
    { "binding": "PUBLIC_STATUS", "service": "core", "entrypoint": "PublicStatus" },
    { "binding": "CORE_SERVICE", "service": "core" },
    { "binding": "AI_SERVICE", "service": "ai" },
    { "binding": "COLLECTOR_SERVICE", "service": "collector" }
  ],
  "kv_namespaces": [
    { "binding": "LAG", "id": "e9c72a9517884aeb95db7386b630a691" }
  ],
  "r2_buckets": [
    { "binding": "IMAGE_OBJECTS", "bucket_name": "lyjw-homepage" },
    { "binding": "ASSET_ARCHIVE", "bucket_name": "lyjw-homepage" }
  ],
  "images": { "binding": "IMAGES" },
  // 一页最多报 MAX_REPORTS_PER_PAGE（src/lib/error-report.ts）条；按 IP 的限额给刷新留余量，超出的不进日志。
  "ratelimits": [
    { "name": "RELAY_LIMIT", "namespace_id": "13105", "simple": { "limit": 20, "period": 60 } },
    { "name": "APPLE_LOOKUP_LIMIT", "namespace_id": "13106", "simple": { "limit": 60, "period": 60 } }
  ],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
    "issues": { "enabled": true }
  },
  "cache": { "enabled": false },
  "exports": {
    "RenderedSite": { "type": "worker", "cache": { "enabled": true } },
    "StatusSnapshot": { "type": "worker", "cache": { "enabled": true } },
    "ImageVariants": { "type": "worker", "cache": { "enabled": true } }
  }
}
