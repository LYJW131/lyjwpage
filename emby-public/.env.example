# 拷成 .env 放在本目录，chmod 600。全是秘密，别进仓库。

# Emby 内网地址
EMBY_SERVER=http://192.168.3.42:8096

# guest 用户的 Id（Emby 后台 → 用户 → guest，地址栏里的 userId）
EMBY_GUEST_USER_ID=

# guest 的长期 access token。签发方式见 README「重新签 token」。
# 这是整站唯一的真 token，只能在这台机器上；浏览器里那份是假的。
EMBY_GUEST_TOKEN=

# Cloudflare Zero Trust → Networks → Tunnels 里那条隧道的 token
CLOUDFLARE_TUNNEL_TOKEN=
