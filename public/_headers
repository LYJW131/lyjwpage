/assets/*
  Cache-Control: public, max-age=31536000, immutable

/explainer/a/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate

/site-assets/model-icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# README 经 GitHub camo 引用的图；缓存只给一天，重新生成后不至于久久不换。
/readme/*
  Cache-Control: public, max-age=86400

# 须与 scripts/preview-worker-name.ts#SITE_PREVIEW_DOMAIN 同步；Worker 渲染的页面由 workers/site/src/index.ts#withoutIndexing 加。
https://:preview.preview.lyjw.dev/*
  X-Robots-Tag: noindex, nofollow
