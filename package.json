{
  "name": "lyjwpage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node --env-file-if-exists=.env.local --import tsx --import ./src/lib/testing/register-alias.mjs scripts/build-site-assets.tsx",
    "dev": "pnpm assets && react-router dev --port ${DEV_SITE_PORT:-3211}",
    "dev:worker": "node scripts/dev-worker.mjs",
    "dev:local": "pnpm assets && SITE_ENV=development PUBLIC_BACKEND_URL=http://localhost:${DEV_WORKER_PORT:-8788} react-router dev --port ${DEV_SITE_PORT:-3211}",
    "dev:override": "node scripts/dev-override.mjs",
    "docs:architecture": "node scripts/architecture-diagram.mjs",
    "design:scale": "node scripts/design-scale-check.ts",
    "docs:check": "node scripts/docs-check.ts",
    "docs:comment-only": "node scripts/comment-only-check.ts",
    "rules:check": "node scripts/rules-check.ts",
    "baselines:check": "node scripts/baseline-growth-check.ts",
    "ui:copy": "node scripts/ui-copy-check.ts",
    "memory:mirror": "node scripts/memory-mirror.ts",
    "build": "node scripts/build.mjs",
    "merge-message": "node scripts/merge-message.ts",
    "preview:deploy": "node scripts/deploy-site-preview.mjs",
    "start": "wrangler dev --config build/server/wrangler.json --local --var SITE_ENV:development --var R2_PUBLIC_BASE_URL:https://lyjw.me/img --port ${DEV_SITE_PORT:-3211}",
    "test": "node --test --experimental-strip-types --import ./src/lib/testing/register-alias.mjs src/lib/*.test.mts shared/*.test.mts shared/*.test.mjs",
    "typecheck": "wrangler types -c wrangler.jsonc -c workers/core/wrangler.toml --strict-vars=false && react-router typegen && tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@clock-ui/react": "^0.1.2",
    "@lobehub/icons": "^5.23.0",
    "@number-flow/react": "^0.6.2",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "8.4.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@cloudflare/vite-plugin": "1.63.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "10.0.1",
    "@react-router/dev": "8.4.0",
    "@resvg/resvg-js": "2.6.2",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "parse5": "^7.3.0",
    "satori": "0.35.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@10.14.0"
}
