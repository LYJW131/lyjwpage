# 站点源。上报器自己拼 /api/ingest/server。给了 SITE_INGEST_URL 就用那条，
# 不再拼。本地开发指到 http://127.0.0.1:3211，生产指到 https://lyjw.me
# （或国内那份 https://lyjw131.com）—— 上报器只跟一个源站说话，对端靠
# INGEST_PEERS 传播。
SITE_URL=https://lyjw.me
# SITE_INGEST_URL=

# 和站点同名变量对上，作 Bearer 鉴权。站点没配时才可留空。
TELEMETRY_INGEST_SECRET=

# 节点名。落地城市优先用查 IP 得到的 city，查不到才用 HOST_LOCATION。
HOST_ID=misaka-jp
HOST_LOCATION=Tokyo

# 采集和上报的间隔。站点那侧的断流窗口默认 45 秒（三倍），这边改长了
# 那边的 SERVER_STALE_MS 要跟着放宽。
INTERVAL_MS=15000
PUSH_TIMEOUT_MS=10000
