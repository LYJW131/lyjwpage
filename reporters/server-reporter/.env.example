# API Worker 的源，上报器从它拼 /api/ingest/server。
# SITE_INGEST_URL 可覆盖上报端点；本地联调可填写本地 API Worker 地址。
SITE_URL=https://api.homepage.lyjw.llc
# SITE_INGEST_URL=

# Access service token（lyjwpage-server）。配了就走 Access，这时 SITE_INGEST_URL 填
# https://ingest.homepage.lyjw.llc/api/ingest/server
ACCESS_CLIENT_ID=
ACCESS_CLIENT_SECRET=
# 过渡期的旧共用 Bearer，上面两项配好后可删。
TELEMETRY_INGEST_SECRET=

# 节点名。落地城市优先用查 IP 得到的 city，查不到才用 HOST_LOCATION。
HOST_ID=misaka-jp
HOST_LOCATION=Tokyo

# 每轮间隔。固定每分钟一推，这份快照本身就是心跳；站点的断流窗口 SERVER_STALE_MS 要比它宽。
INTERVAL_MS=60000
PUSH_TIMEOUT_MS=10000

# 流量统计。状态文件落在挂进来的卷上，跨容器重建、跨机器重启接着数；
# 留空就是不攒流量，卡片上不显示那一栏。
TRAFFIC_STATE_PATH=/data/traffic.json
# 周期从每月几号归零，跟着套餐账单日填，1–28。misaka-jp 的账单日是 1 号。
TRAFFIC_CYCLE_DAY=1
# 套餐配额，字节。配了卡片才画进度条（按上下行之和算），没配只报用量。
# 流量按十进制记：2T = 2×10^12，和账单、和卡片上的速率同一套单位。
TRAFFIC_QUOTA_BYTES=2000000000000
