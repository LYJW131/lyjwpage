{
  "name": "@lyjwpage/server-reporter",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "把落地节点的 CPU / 内存 / 磁盘 / 网速 / 周期流量推送到 lyjwpage",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test --experimental-strip-types src/*.test.mts",
    "start": "node dist/index.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
