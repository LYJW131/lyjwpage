SITE_URL=https://api.homepage.lyjw.llc
TELEMETRY_INGEST_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
# Keep true until the API Worker supports /api/ingest/discord.
DRY_RUN=true
HEARTBEAT_INTERVAL_MS=60000
PUSH_TIMEOUT_MS=15000

# Enable after one-time OAuth authorization; credentials stay in the data volume.
DISCORD_OAUTH_DIR=/app/data
