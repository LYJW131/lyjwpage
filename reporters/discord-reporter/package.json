{
  "name": "@lyjwpage/discord-reporter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把 Discord 的正在游戏（Quest 3）推送到 lyjwpage",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
