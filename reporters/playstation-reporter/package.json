{
  "name": "@lyjwpage/playstation-reporter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把 PSN 的「此刻在玩」和「最近在玩」推送到 lyjwpage（原型，站点侧端点尚未实现）",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "once": "node dist/index.js --once"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "dependencies": {
    "psn-api": "^2.18.1"
  }
}
