        "id": "relay",
        "label": "两份生产互转",
        "focus": [
          "vercel",
          "edgeone",
          "redis_vercel",
          "redis_edgeone"
        ],
        "note": "收到上报的那份原样转给对端，对端写自己的 Redis、刷自己的 tag。"
      },
      {
        "id": "push",
        "label": "浏览器三条腿",
        "focus": [
          "vercel",
          "edgeone",
          "live_push",
          "browser"
        ],
        "note": "SSR 首屏、SWR 轮询 /api/status/*、live-push 的 WebSocket 推送。"
      },
      {
        "id": "counter",
        "label": "在线人数反馈环",
        "focus": [
          "browser",
          "online_counter",
          "psn_reporter",
          "lan_reporters"
        ],
        "note": "浏览器连上就是一个人头，上报器读 /count 在快慢两档之间切换。"
      },
      {
        "id": "assets",
        "label": "图片直传 R2",
        "focus": [
          "device_hubs",
          "lan_reporters",
          "r2"
        ],
        "note": "上报侧把图片字节直传 R2，站点只收 objectKey，从不经手图片本身。"
      }
    ]
