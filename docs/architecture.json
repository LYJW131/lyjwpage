      {
        "id": "layers",
        "label": "实时层与可滞后层",
        "focus": [
          "ingress",
          "api",
          "state_hub",
          "collector",
          "lag_store"
        ],
        "note": "ingress 校验、收敛后拆开：实时那一半经 Service Binding 交给 StateCore 写 Durable Object，可滞后层、D1 归档与凭据自己写。采集 Worker 每分钟拉外部服务，同样分两路写。"
      },
      {
        "id": "sites",
        "label": "站点与读取",
        "focus": [
          "api",
          "sites",
          "visitors",
          "esa"
        ],
        "note": "Vercel 首屏按卡读 /api/status/*；浏览器挂载后直连 api Worker 与 /ws。lyjw131.com 经 ESA 回源 lyjw.me。API 只在布局变化时通知 Vercel 标签失效。"
      },
      {
        "id": "assets",
        "label": "图片链路",
        "focus": [
          "mac_hub",
          "emby_reporter",
          "images",
          "sites",
          "esa",
          "visitors"
        ],
        "note": "上报器直传 R2，页面里的图片是 /img/ 同源路径：lyjw.me 由 Vercel 边缘 rewrite 回源 R2，lyjw131.com 由 ESA 缓存同一路径并回源 lyjw.me。"
      }
    ],
