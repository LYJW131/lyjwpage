{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lyjwpage",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3211,
      "autoPort": false
    },
    {
      "name": "api-worker-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:worker"],
      "port": 8788,
      "autoPort": false
    },
    {
      "name": "lyjwpage-local",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:local"],
      "port": 3211,
      "autoPort": false
    },
    {
      "name": "lyjwpage-attach",
      "url": "http://localhost:3211",
      "port": 3211
    },
    {
      "name": "api-worker-alt",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "DEV_WORKER_PORT=8790 exec pnpm dev:worker"],
      "port": 8790,
      "autoPort": false
    },
    {
      "name": "explainer-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": ["docs/explainer/render/serve.mjs", "public", "4817"],
      "port": 4817,
      "autoPort": false
    },
    {
      "name": "lyjwpage-local-alt",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "NEXT_DIST_DIR=.next/alt DEV_WORKER_PORT=8790 DEV_SITE_PORT=3213 exec pnpm dev:local"],
      "port": 3213,
      "autoPort": false
    }
  ]
}
