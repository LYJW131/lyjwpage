name = "online-counter"
main = "src/index.ts"
compatibility_date = "2024-12-30"
workers_dev = true

# routes = [
#   { pattern = "online.example.com", custom_domain = true }
# ]

[vars]
# 逗号分隔。**留空或整段删掉 = 谁都能连**（本地 localhost 始终放行）。
# 预览域名每次部署都换，用后缀通配收进来。
ALLOWED_ORIGINS = "https://example.com,https://*.vercel.app"

[[durable_objects.bindings]]
name = "ONLINE_COUNTER"
class_name = "OnlineCounterRoom"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["OnlineCounterRoom"]

[observability]
enabled = true
