{
  "name": "@lyjwpage/ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Public AI chat, site tools and MCP on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev -c wrangler.toml",
    "deploy": "wrangler deploy -c wrangler.toml",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --import ../../src/lib/testing/register-alias.mjs src/*.test.ts",
    "chat:probe": "node --experimental-strip-types --import ../../src/lib/testing/register-alias.mjs scripts/chat-probe.ts",
    "digest:probe": "node --experimental-strip-types --import ../../src/lib/testing/register-alias.mjs scripts/digest-probe.ts",
    "digest:taglines": "node --experimental-strip-types --import ../../src/lib/testing/register-alias.mjs scripts/digest-taglines.ts",
    "designer:setup": "node --experimental-strip-types --import ../../src/lib/testing/register-alias.mjs scripts/setup-designer.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0"
  }
}
