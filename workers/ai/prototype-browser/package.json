{
  "name": "ai-browser-harness-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild app.ts --bundle --platform=browser --format=esm --minify --metafile=meta.json --tsconfig=tsconfig.app.json --outfile=public/app.js",
    "dev": "pnpm run build && ../node_modules/.bin/wrangler dev --config wrangler.toml --port 8792 --inspector-port 9332"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
