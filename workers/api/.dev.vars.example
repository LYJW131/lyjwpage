# 本地复制为 .dev.vars；云端敏感值用 wrangler secret 配置，禁止提交真实值。
TELEMETRY_INGEST_SECRET=
# 临时导入权限，与上报密钥分开；初始化结束后删除。
STATE_IMPORT_SECRET=
GITHUB_TOKEN=
# 「一起听」签 MusicKit developer token 用的 .p8 全文；不配则 /api/musickit/token 回 500。
# 本地不配 ALLOWED_ORIGINS 时签出的令牌不带 origin 声明。
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
STORAGE_PREFIX=lyjwpage
SITE_URL=http://localhost:3211
ALLOWED_ORIGINS=http://localhost:3211
R2_PUBLIC_BASE_URL=https://img.example.com
EMBY_PUBLIC_URL=https://emby.example.com
APPLE_MUSIC_STOREFRONT=cn
HEARTBEAT_WINDOW_MS=300000
CHARGER_PUSH_INTERVAL_MS=30000
AGENT_LIMITS_STALE_MS=11100000
