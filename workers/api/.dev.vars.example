# 本地复制为 .dev.vars；云端敏感值用 wrangler secret 配置，禁止提交真实值。
# 本地上报鉴权。线上上报走 Cloudflare Access（见 src/access-auth.ts），本地没有 Access，
# 过渡期用这把旧 Bearer 往本地 Worker 推；调站点 /api/revalidate 也退回用它。
TELEMETRY_INGEST_SECRET=
# 导入 / 初始化权限，与上报密钥分开。本地随便填一个，`pnpm dev:worker:init` 用
# --env-file 读它来初始化空库；云端只在迁移时临时配置，结束后删除。
STATE_IMPORT_SECRET=dev-import
GITHUB_TOKEN=
# 站点卡片只读查询：仅 API Worker 使用，不放到 Next.js / NEXT_PUBLIC_*。
# 账号 / 项目 / 团队 ID 已在 wrangler.toml 的 [vars]，本地不用重复。
CLOUDFLARE_METRICS_TOKEN=
# Google PageSpeed Insights：cron 每小时实测一次 lyjw.me 的 Lighthouse 性能分。
# 不配就跳过实测，卡片显示上次结果或 —。
PAGESPEED_API_KEY=
# Vercel 团队范围 Token：部署、调用量和访问统计共用
VERCEL_TOKEN=
# TypeSafe AI 的 API 密钥，给 pulse 活动分用（Jev 评估模型，十分钟最多一次）。
# 不配就不打分，/api/status/pulse 照常返回泳道、分是 null。
TYPESAFE_API_KEY=
# 可选。Sentry 组织只读令牌（org:read / project:read / event:read），站点卡片的在线率与错误数用；
# 不配时 /api/status/sentry 回暂无数据，本地看效果用 pnpm dev:override 注入夹具。
SENTRY_API_TOKEN=
# 只给本地开发：生产为主、本地补缺 —— 生产有的数据用生产的，生产没有的端点和
# 字段用本地的（只读，不碰上报）。测本地上报链路时注释掉。生产的 wrangler.toml
# 绝不配它，见 src/public-api.ts。
UPSTREAM_API_URL=https://api.homepage.lyjw.llc
# 只给本地开发：开放 PUT/DELETE /api/dev/override/<端点> 注入假数据（`pnpm dev:override`），
# 注入的优先于上游和本地。生产的 wrangler.toml 绝不配它。
DEV_OVERRIDES=true
# 「一起听」签 MusicKit developer token 用的 .p8 全文；不配则 /api/musickit/token 回 500。
# 本地不配 ALLOWED_ORIGINS 时签出的令牌不带 origin 声明。
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
STORAGE_PREFIX=lyjwpage
SITE_URL=http://localhost:3211

ALLOWED_ORIGINS=http://localhost:3211
EMBY_PUBLIC_URL=https://emby.example.com
APPLE_MUSIC_STOREFRONT=cn
HEARTBEAT_WINDOW_MS=300000
CHARGER_PUSH_INTERVAL_MS=30000
AGENT_LIMITS_STALE_MS=11100000
