# 站点是 Cloudflare 上的 site Worker：React Router SSR 渲染页面、缓存响应、处理图片。
# 构建期写进浏览器包：状态、推送与对话请求都发往这个源。生产是站点自己的域名，由 site Worker 按归属转交 core / ai。
# 只填源，代码负责拼接路径。
PUBLIC_BACKEND_URL=https://lyjw.me
# 预览/本地要指到别的后端时用它，一旦设置就压过 PUBLIC_BACKEND_URL。
PREVIEW_BACKEND_URL=
# R2 公开源（自定义域，含 /img 前缀）。页面上的图片是 `/img/<对象键>` 同源路径：生产由
# site Worker 的 R2 绑定直出，本地与非生产预览从这个公共源抓原件。只进服务端，不烧进浏览器包。
R2_PUBLIC_BASE_URL=https://img.example.com
PUBLIC_SIGNED_IMAGE_OPTIMIZATION=true
# Cloudflare Web Analytics 的 beacon token 按域名给，JSON map；不配就不上报。
PUBLIC_CF_WEB_ANALYTICS_TOKENS={"lyjw.me":"","lyjw131.com":""}
# 本地默认不上报浏览器错误（/relay），要试就设 true。
PUBLIC_ERROR_REPORT_DEV=
# 「一起听」的 MusicKit developer token 也从上面那个源拼 /api/musickit/token，
# 没有单独的变量；私钥和允许的域名都配在 Worker 上。
FOOTER_EXTRA_TEXT=
FOOTER_EXTRA_HREF=
# 状态数据用的 GitHub / Apple 凭据和遥测新鲜度配置均归 Worker，见 workers/core/.dev.vars.example。
