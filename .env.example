# Vercel / Next.js：只渲染首屏、缓存页面和处理图片。
# 构建和浏览器使用同一个 Worker 公开源。只填源，代码负责拼接路径。
NEXT_PUBLIC_BACKEND_URL=https://api.homepage.lyjw.llc
NEXT_PUBLIC_ONLINE_COUNTER_URL=https://online.homepage.lyjw.llc
# Worker 调用 /api/revalidate 的鉴权，只有 Vercel 和 api Worker 两边有。
REVALIDATE_SECRET=
# R2 公开源（自定义域）。页面上的图片是 `/img/<对象键>` 同源路径，next.config 把它
# rewrite 到这里（Vercel 边缘代理并缓存），首屏图标内联也从这里抓原件。不配 R2 写入凭据。
R2_PUBLIC_BASE_URL=https://img.example.com
# 只给「自建部署 + fake-IP 代理」用；next dev 已默认放开，Vercel 上不要设。
IMAGE_ALLOW_LOCAL_IP=false
NEXT_PUBLIC_SIGNED_IMAGE_OPTIMIZATION=true
# 「一起听」的 MusicKit developer token 也从上面那个 Worker 源拼 /api/musickit/token，
# 没有单独的变量；私钥和允许的域名都配在 Worker 上。
FOOTER_EXTRA_TEXT=
FOOTER_EXTRA_HREF=
# 可选。只给构建期读公开仓的「最近提交」列表用，不配也能匿名读，配上避开匿名限额。
GITHUB_TOKEN=
# 状态数据用的 GitHub / Apple 凭据和遥测新鲜度配置均归 Worker，见 workers/api/.dev.vars.example。
